
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- GLOBAL HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Safer isAdmin check that won't crash if the user document doesn't exist yet
    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
      
      // Nested collections under user (apiKeys, devices, paymentSessions, etc.)
      match /{allPaths=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /stores/{storeId} {
      // Allow read if user owns the store (checked via userId field in the doc) or is admin
      // Note: 'resource' refers to the existing data in the database
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      
      // Allow creation only if the user is signed in and sets themselves as the owner
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      
      // Allow updates/deletes if user owns the store or is admin
      allow update, delete: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
    }

    match /public_payment_sessions/{sessionId} {
      allow get: if true;
      allow update: if resource.data.status == 'pending' || isAdmin();
    }
    
    match /subscriptionPlans/{planId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }
  }
}
