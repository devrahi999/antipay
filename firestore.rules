
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- GLOBAL HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    // Safer isAdmin check: direct document access check
    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- COLLECTION RULES ---

    // User profiles and private data
    match /users/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      
      // Allow access to all nested collections under a user
      match /{allPaths=**} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    // Root-level stores (Brands)
    match /stores/{storeId} {
      // Allow list if the query filters by the user's own UID or if they are admin
      // This is the key fix for the 'list' error
      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      
      // Basic read/write permissions for specific documents
      allow get: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
    }

    // Public payment links for customers
    match /public_payment_sessions/{sessionId} {
      allow get: if true;
      allow update: if resource.data.status == 'pending' || isAdmin();
    }
    
    // Global subscription plans
    match /subscriptionPlans/{planId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }
  }
}
