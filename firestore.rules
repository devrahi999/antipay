rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- AntiPay Gateway Rules (At Top for Priority) ---

    match /stores/{apiKey} {
      allow read: if true; 
      allow write: if false; 
    }

    match /payment_sessions/{userId}/sessions/{sessionId} {
      allow get: if true;
      allow list: if request.auth != null && (request.auth.uid == userId || 
                    (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true));
      allow create, update: if true;
    }

    match /{path=**}/sessions/{sessionId} {
      allow get, list: if true;
    }

    // Webhook and Activation Access
    match /plan_transactions/{sessionId} {
      allow read, write: if true;
    }

    
    match /transactions/{trxId} {
      allow create, read, update: if true;
      allow delete: if false;
    }

    // --- Existing System Rules (Preserved) ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      
      match /{allSubCollections=**} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }
    
    match /users {
      allow list: if isAdmin();
    }

    match /user_plans/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    match /stores/{storeId} {
      allow get, update, delete: if isSignedIn() && (isAdmin() || (resource != null && resource.data.userId == request.auth.uid));
      allow create: if isSignedIn();
      allow list: if isSignedIn() && (isAdmin() || request.query.limit <= 100);
    }
    
    match /subscriptionPlans/{planId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // Manual admin review requests raised from the checkout page.
    // The gateway route runs unauthenticated (client SDK, server-side), so the
    // submission and the settlement write have to stay open — same posture as
    // `payment_sessions` and `transactions` above. Browsing and deleting are
    // locked to the owning merchant so nobody can read another merchant's queue.
    match /pending_transactions/{reviewId} {
      allow get, create, update: if true;
      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow delete: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
    }

    match /devices/{brandId} {
      allow read, write: if isSignedIn();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{allPaths=**}/paymentSessions/{sessionId} {
      allow read: if isAdmin();
    }
  }
} 