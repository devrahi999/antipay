
{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a merchant user within the AntiPay system. This entity links all user-specific data, assuming external authentication.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the UserProfile entity."
        },
        "email": {
          "type": "string",
          "description": "The email address associated with the user's account.",
          "format": "email"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when the user profile was created.",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp when the user profile was last updated.",
          "format": "date-time"
        },
        "webhookUrl": {
          "type": "string",
          "description": "Optional URL for receiving system webhooks and notifications.",
          "format": "uri"
        }
      },
      "required": [
        "id",
        "email",
        "createdAt",
        "updatedAt"
      ]
    },
    "Store": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Store",
      "type": "object",
      "description": "Details about a merchant's store, associated with an API key and user, used for branding and redirect purposes.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Store entity."
        },
        "userId": {
          "type": "string",
          "description": "Reference to the UserProfile this store belongs to."
        },
        "name": {
          "type": "string",
          "description": "The name of the merchant's store."
        },
        "websiteUrl": {
          "type": "string",
          "description": "The public website URL of the merchant's store.",
          "format": "uri"
        },
        "logoUrl": {
          "type": "string",
          "description": "URL to the store's logo image.",
          "format": "uri"
        },
        "supportEmail": {
          "type": "string",
          "description": "Email address for customer support.",
          "format": "email"
        },
        "apiKey": {
          "type": "string",
          "description": "The API key associated with this brand (same as doc ID)."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when created.",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp when updated.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "name",
        "websiteUrl",
        "createdAt",
        "updatedAt"
      ]
    },
    "PaymentSession": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "PaymentSession",
      "type": "object",
      "description": "Represents a single payment request initiated by a client.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier."
        },
        "userId": {
          "type": "string",
          "description": "Merchant UID."
        },
        "amount": {
          "type": "number"
        },
        "method": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "auth": {
    "providers": [
      "password",
      "google.com"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": {
            "$ref": "#/backend/entities/UserProfile"
          },
          "description": "Merchant profiles."
        }
      },
      {
        "path": "/stores/{storeId}",
        "definition": {
          "entityName": "Store",
          "schema": {
            "$ref": "#/backend/entities/Store"
          },
          "description": "Root level brands collection."
        }
      }
    ]
  }
}
