
{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a merchant user within the AntiPay system.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "subscriptionPlanId": { "type": "string" },
        "subscriptionStartedAt": { "type": "string", "format": "date-time" },
        "subscriptionExpiresAt": { "type": "string", "format": "date-time" },
        "isAdmin": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "UserPlan": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserPlan",
      "type": "object",
      "description": "Active plan details for a specific user.",
      "properties": {
        "id": { "type": "string", "description": "The userId" },
        "planId": { "type": "string" },
        "planName": { "type": "string" },
        "price": { "type": "number" },
        "billingCycle": { "type": "string" },
        "maxApiKeys": { "type": "number" },
        "maxDevices": { "type": "number" },
        "benefits": { "type": "array", "items": { "type": "string" } },
        "activatedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "Store": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Store",
      "type": "object",
      "description": "Merchant brand details.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "websiteUrl": { "type": "string" },
        "logoUrl": { "type": "string" },
        "apiKey": { "type": "string" },
        "status": { "type": "string" },
        "isActive": { "type": "boolean", "default": true },
        "connected_devices_count": { "type": "number", "default": 0 },
        "redirectSuccessUrl": { "type": "string" },
        "redirectCancelUrl": { "type": "string" },
        "supportEmail": { "type": "string" },
        "supportPhone": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "supportPageLink": { "type": "string" },
        "methods": { 
          "type": "array",
          "items": { "type": "object" }
        }
      }
    },
    "SubscriptionPlan": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "SubscriptionPlan",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "benefits": { "type": "array", "items": { "type": "string" } },
        "billingCycle": { "type": "string", "enum": ["monthly", "yearly", "lifetime"] },
        "maxApiKeys": { "type": "number" },
        "maxDevices": { "type": "number" },
        "isFreeTrialAvailable": { "type": "boolean" }
      }
    },
    "PlanTransaction": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "PlanTransaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "planId": { "type": "string" },
        "planName": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": [ "password", "google.com" ]
  },
  "firestore": {
    "structure": [
      { "path": "/users/{userId}", "definition": { "entityName": "UserProfile", "description": "User profile data." } },
      { "path": "/user_plans/{userId}", "definition": { "entityName": "UserPlan", "description": "User's active subscription details." } },
      { "path": "/stores/{storeId}", "definition": { "entityName": "Store", "description": "Global stores collection." } },
      { "path": "/subscriptionPlans/{planId}", "definition": { "entityName": "SubscriptionPlan", "description": "Global plans defined by Admin." } },
      { "path": "/plan_transactions/{txId}", "definition": { "entityName": "PlanTransaction", "description": "History of plan purchases." } },
      { "path": "/devices/{brandId}", "definition": { "entityName": "object", "description": "Root devices mapped by brandId." } }
    ]
  }
}
