{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a merchant user within the AntiPay system.",
      "properties": {
        "id": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "displayName": {
          "type": "string"
        },
        "photoURL": {
          "type": "string"
        },
        "subscriptionPlanId": {
          "type": "string",
          "description": "The ID of the currently active subscription plan."
        },
        "subscriptionStartedAt": {
          "type": "string",
          "format": "date-time"
        },
        "subscriptionExpiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "isAdmin": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "Store": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Store",
      "type": "object",
      "description": "Merchant brand details.",
      "properties": {
        "id": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "websiteUrl": {
          "type": "string"
        },
        "apiKey": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      }
    },
    "SubscriptionPlan": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "SubscriptionPlan",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "benefits": { "type": "array", "items": { "type": "string" } },
        "billingCycle": { "type": "string", "enum": ["monthly", "yearly"] },
        "maxApiKeys": { "type": "number" },
        "maxDevices": { "type": "number" },
        "isFreeTrialAvailable": { "type": "boolean" }
      }
    }
  },
  "auth": {
    "providers": [
      "password",
      "google.com"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": {
            "$ref": "#/backend/entities/UserProfile"
          },
          "description": "User profile data."
        }
      },
      {
        "path": "/stores/{storeId}",
        "definition": {
          "entityName": "Store",
          "schema": {
            "$ref": "#/backend/entities/Store"
          },
          "description": "Global stores collection."
        }
      },
      {
        "path": "/subscriptionPlans/{planId}",
        "definition": {
          "entityName": "SubscriptionPlan",
          "schema": {
            "$ref": "#/backend/entities/SubscriptionPlan"
          },
          "description": "Global plans defined by Admin."
        }
      }
    ]
  }
}
